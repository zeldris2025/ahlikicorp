# Django
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,example.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ahlikicorp_db

# Redis (optional, falls back to in-memory cache if not set)
REDIS_URL=redis://localhost:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-resend-api-key
EMAIL_HOST_PASSWORD=your-resend-api-key
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@ahliki.com
QUOTE_NOTIFICATION_EMAIL=quotes@ahliki.com

# AWS S3 (optional for media storage)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# Sentry (optional error tracking)
SENTRY_DSN=

# Site
SITE_NAME=Ah Liki
SITE_DOMAIN=ahliki.com
