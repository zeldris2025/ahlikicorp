# Django
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,example.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ahlikicorp_db

# Redis (optional, falls back to in-memory cache if not set)
REDIS_URL=redis://localhost:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-resend-api-key
EMAIL_HOST_PASSWORD=your-resend-api-key
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@ahliki.com
QUOTE_NOTIFICATION_EMAIL=quotes@ahliki.com

# AWS S3 (optional for media storage)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# Sentry (optional error tracking)
SENTRY_DSN=

# Site
SITE_NAME=Ah Liki
SITE_DOMAIN=ahliki.com

# Social profiles (shown in header + footer; leave blank to render as inactive)
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
SOCIAL_LINKEDIN=

# reCAPTCHA v2 checkbox on the contact form (https://www.google.com/recaptcha/admin)
# Set to True once the site is on its real domain (and that domain is on the key's list).
RECAPTCHA_ENABLED=True
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Header and widget toggles
SHOW_ASSISTANT=True
EMPLOYMENT_URL=

# Email through Microsoft 365 (Graph API). Register an app in Entra ID, give it the
# Mail.Send *application* permission with admin consent, then fill these in and
# switch EMAIL_BACKEND to core.graph_email.GraphEmailBackend.
# EMAIL_BACKEND=core.graph_email.GraphEmailBackend
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=noreply@ahliki.com
